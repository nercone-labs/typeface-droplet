<?xml version="1.0" encoding="utf-8"?>
<!--
    A customization document written for the tests, following the grammar of
    android.graphics.fonts.FontCustomizationParser (Android 13 to 17):
    new-named-family families and family lists, new-locale-family families and aliases.
-->
<fonts-modification version="1">
    <family customizationType="new-named-family" name="google-sans">
        <font weight="400" style="normal">GoogleSans-Regular.ttf</font>
        <font weight="500" style="normal">GoogleSans-Medium.ttf</font>
        <font weight="400" style="italic">GoogleSans-Italic.ttf</font>
    </family>
    <family customizationType="new-named-family" name="google-sans-text">
        <font supportedAxes="wght,ital">GoogleSansText-Regular.ttf
          <axis tag="GRAD" stylevalue="0"/>
        </font>
    </family>
    <family customizationType="new-named-family" name="vendor-display">
        <font weight="400" style="normal">VendorDisplay-Regular.otf</font>
    </family>
    <family-list customizationType="new-named-family" name="google-sans-flex">
        <family>
            <font supportedAxes="wght">GoogleSansFlex-Regular.ttf</font>
        </family>
    </family-list>
    <family customizationType="new-locale-family" operation="prepend" lang="ja">
        <font weight="400" style="normal">VendorGothic-Regular.ttf</font>
    </family>
    <alias name="google-sans-medium" to="google-sans" weight="500"/>
</fonts-modification>
